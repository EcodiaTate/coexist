# ================================================================
# Co-Exist Environment Configuration
# ================================================================
# Copy this file to .env.local for development
# Copy to .env.production for production builds
#
# NEVER commit .env.local or .env.production to git
# ================================================================

# ---- Supabase ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Stripe ----
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# ---- GreenPay (STAGED, gated OFF - see GREENPAY-STAGING-DO-NOT-MERGE.md) ----
# GreenPay (greenpay.au) is a white-label of Fat Zebra. Payments route through
# GreenPay ONLY when VITE_GREENPAY_ENABLED=true AND a publishable key is set;
# otherwise the payment seam falls back to Stripe. No keys are held today -
# leave these unset/false. Never flip on until real sandbox keys land.
VITE_GREENPAY_ENABLED=false
VITE_GREENPAY_PUBLISHABLE_KEY=

# ---- Analytics (provider: "posthog" | "plausible" | "mixpanel" | "none") ----
VITE_ANALYTICS_PROVIDER=none
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ---- Sentry (error reporting) ----
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0

# ================================================================
# Supabase Edge Function Secrets (set via Supabase Dashboard)
# These are NOT prefixed with VITE_ - they are server-only
# ================================================================
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# ---- GreenPay edge-function secrets (STAGED, gated OFF - no keys held) ----
# Server-side gate: GreenPay routes ONLY when GREENPAY_ENABLED=true AND the
# credentials below are present; otherwise every edge function stays on Stripe.
# GreenPay is a white-label of Fat Zebra (HTTP Basic username:token).
# GREENPAY_ENABLED=false
# GREENPAY_API_BASE=https://gateway.pmnts-sandbox.io   # sandbox; prod = gateway.pmnts.io
# GREENPAY_USERNAME=your-greenpay-username
# GREENPAY_TOKEN=your-greenpay-api-token
# GREENPAY_WEBHOOK_SECRET=your-greenpay-webhook-signing-secret
#
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=hello@coexistaus.org
# SENDGRID_FROM_NAME=Co-Exist
# SENDGRID_TPL_WELCOME=d-...
# SENDGRID_TPL_EVENT_CONFIRMATION=d-...
# SENDGRID_TPL_EVENT_REMINDER=d-...
# SENDGRID_TPL_EVENT_CANCELLED=d-...
# SENDGRID_TPL_EVENT_INVITE=d-...
# SENDGRID_TPL_WAITLIST_PROMOTED=d-...
# SENDGRID_TPL_PASSWORD_RESET=d-...
# SENDGRID_TPL_DONATION_RECEIPT=d-...
# SENDGRID_TPL_ORDER_CONFIRMATION=d-...
# SENDGRID_TPL_ORDER_SHIPPED=d-...
# SENDGRID_TPL_DATA_EXPORT=d-...
# SENDGRID_TPL_NEWSLETTER=d-...
# SENDGRID_TPL_CHALLENGE=d-...
# SENDGRID_TPL_IMPACT_RECAP=d-...
# SENDGRID_TPL_ANNOUNCEMENT_DIGEST=d-...
#
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
